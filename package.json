{
  "name": "agent-claudecode",
  "version": "1.0.0",
  "description": "Agent-ClaudeCode: the Claude Code workflow as a selectable DeepSeek Harness mode. Selecting it takes the Harness workflow offline and puts the Claude Code agent loop in charge, with claude / codex / harness backends.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./workflow": "./lib/workflow.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "skills",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test test/"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent-preset",
    "claude-code",
    "codex",
    "coding-agent",
    "workflow"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WPH666-py/DSH-claudecode.git"
  },
  "homepage": "https://github.com/WPH666-py/DSH-claudecode#readme",
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
